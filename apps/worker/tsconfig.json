{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Runtime types from `pnpm cf-typegen` (worker-configuration.d.ts),
    // Node types for the server sources (NodeJS.Timeout) under nodejs_compat
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // Same safety flags as apps/server, which this compiles sources from
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,

    // The game itself lives in apps/server; wrangler bundles it from there
    "paths": {
      "@/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "worker-configuration.d.ts"]
}
