{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "incremental": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  }
}