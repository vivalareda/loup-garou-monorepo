{
  "name": "loup-garou",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "effect-language-service patch",
    "dev": "turbo dev PORT=3000 HOST=0.0.0.0",
    "lint": "turbo run lint",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:mobile": "turbo -F mobile dev",
    "dev:web": "turbo run dev --filter=dashboard --filter=server",
    "dev:server": "turbo -F server dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@effect/language-service": "^0.67.0",
    "lint-staged": "^16.1.5",
    "turbo": "^2.5.4",
    "typescript": "5.8.3",
    "ultracite": "5.1.8"
  },
  "packageManager": "pnpm@10.14.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite format"
    ]
  },
  "dependencies": {
    "effect": "^3.19.14"
  }
}
