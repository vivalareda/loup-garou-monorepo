{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./src",

    // Type Safety
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,

    // Build Performance
    "incremental": true,
    "skipLibCheck": true,

    // Module Handling
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Development
    "sourceMap": true,

    // Path Aliases
    "paths": {
      "@/*": ["./src/*"]
    },

    // Effect Language Service
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
