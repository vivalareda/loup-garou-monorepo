# http(s) base URL of the game server (e.g. http://192.168.1.10:3000); the
# app connects to its WebSocket endpoint ws(s)://<host>/room/<code>.
# To target the Worker instead: its `wrangler dev` URL on your LAN (e.g.
# http://192.168.1.10:8787, start it with `pnpm --filter worker dev --ip 0.0.0.0`)
# or the deployed https://<name>.<account>.workers.dev
EXPO_PUBLIC_BACKEND_SERVER_URL=
# The Worker's ACCESS_TOKEN, when it has one (appended as ?token=). It is
# compiled into the app: a speed bump against scanners, not authentication
EXPO_PUBLIC_ACCESS_TOKEN=
