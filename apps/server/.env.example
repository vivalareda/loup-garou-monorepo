# HTTP server port (default 3000)
PORT=3000

# Optional: force a specific player to be the HUNTER for testing.
# HUNTER is now part of normal role generation, so this only controls
# WHICH player gets the hunter role (leave empty for random assignment).
DEV_FORCE_HUNTER=

# Optional: log audio that would be played instead of playing mp3s.
# Set to 1 to enable. Useful for verifying segment/audio order without
# listening through recorded narration.
DEBUG_AUDIO=

# Discussion window (ms) between dawn and the day vote (default 120000).
# Any living player can end it early with "Passer au vote". Set to 0 to
# open the vote immediately (headless testing). DAY_VOTE_DELAY_MS is the
# legacy name and is used as a fallback when DAY_DISCUSSION_MS is unset.
DAY_DISCUSSION_MS=
DAY_VOTE_DELAY_MS=

# Number of players a game needs before it auto-starts (default 6,
# minimum 4). The server refuses to boot on an invalid value.
PLAYER_COUNT=6

# Per-segment deadlines in milliseconds. When a phase's required action
# never arrives, the server applies that phase's safe fallback and moves
# on. Set a value <= 0 to disable that deadline entirely.
# Defaults: Cupid 120s, Lovers 60s, Seer 60s, Werewolf 120s, Witch heal
# 60s, Witch poison 60s, day vote 600s, Hunter 60s.
CUPID_TIMEOUT_MS=
LOVERS_TIMEOUT_MS=
SEER_TIMEOUT_MS=
WEREWOLF_TIMEOUT_MS=
WITCH_HEAL_TIMEOUT_MS=
WITCH_POISON_TIMEOUT_MS=
DAY_VOTE_TIMEOUT_MS=
HUNTER_TIMEOUT_MS=

# Overrides every per-segment deadline at once (used by tests and
# headless simulations).
SEGMENT_TIMEOUT_MS=

# Optional: delay (ms) before lovers are alerted of each other (default
# 4000). Set to 0 for headless testing.
LOVER_ALERT_DELAY_MS=

# How long (ms) a disconnected player keeps their seat before the
# disconnect is treated as a death (default 90000). While the grace runs,
# the game does not wait on them for votes/actions; reconnecting within
# the grace fully restores them, including their pending prompt.
DISCONNECT_GRACE_MS=
