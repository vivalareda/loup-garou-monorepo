{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "loup-garou",
  "main": "src/index.ts",
  // Must not be newer than the installed workerd supports
  "compatibility_date": "2026-08-15",
  // node:crypto (core/player.ts) and process.env (filled from "vars")
  "compatibility_flags": ["nodejs_compat"],
  // One GameRoom per room code; each holds its game in memory only
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // The built dashboard, same origin as the game. Only /room/* runs the
  // Worker; every other path is a static file or the SPA's index.html
  "assets": {
    "directory": "../dashboard/dist-worker",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/room/*"],
  },
  // Game config, read through process.env like on Node (same defaults).
  // The per-segment timeouts (WEREWOLF_TIMEOUT_MS, ...) are left to their
  // code defaults: setting them here would shadow SEGMENT_TIMEOUT_MS, the
  // one override for short test games (--var or .dev.vars)
  // ENABLE_ADMIN_EVENTS: "true" turns on the dashboard's admin:* testing
  // tools, which let any client drive the game (local testing only).
  // MAX_CONNECTIONS_PER_ROOM: further upgrades get a 503.
  // ACCESS_TOKEN is deliberately absent: set it as a secret (or --var) to
  // require ?token= on /room/*; unset, rooms are open
  "vars": {
    "PLAYER_COUNT": "6",
    "DISCONNECT_GRACE_MS": "90000",
    "DAY_DISCUSSION_MS": "120000",
    "ENABLE_ADMIN_EVENTS": "false",
    "MAX_CONNECTIONS_PER_ROOM": "32",
  },
  "observability": { "enabled": true },
}
