{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Workers runtime types (`Env` is derived from alchemy.run.ts in
    // env.d.ts), Node types for the server sources (NodeJS.Timeout) under
    // nodejs_compat
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // Same safety flags as apps/server, which this compiles sources from
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,

    // The game itself lives in apps/server; Alchemy bundles it from there
    "paths": {
      "@/*": ["../server/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "alchemy.run.ts",
    "settings.ts",
    "env.d.ts",
    "vitest.config.ts"
  ]
}
