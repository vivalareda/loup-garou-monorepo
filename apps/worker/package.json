{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter dashboard build:worker && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm --filter dashboard build:worker && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@repo/types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@types/node": "^22.19.1",
    "server": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.151.1"
  }
}
