{
  "name": "@loup/game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "test": "pnpm --filter @rat-stack/capability build && vitest run"
  },
  "dependencies": {
    "@rat-stack/capability": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
