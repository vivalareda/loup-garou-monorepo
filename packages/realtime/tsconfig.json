{
  // The client runs on the browser, React Native and Node: no Node types,
  // and DOM only for the timers and console every platform has (it uses
  // the WebSocket shape it declares, never DOM's). The strictest union of
  // the consuming apps' settings, since each of them compiles this source.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["index.ts", "src"]
}
