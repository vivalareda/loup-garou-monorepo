{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter dashboard build:worker && alchemy dev",
    "deploy": "pnpm --filter dashboard build:worker && alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@repo/types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@effect/platform-node": "4.0.5",
    "@types/node": "^22.19.1",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "server": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
