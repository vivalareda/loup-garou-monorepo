# HTTP server port (default 3000)
PORT=3000

# Optional: force a specific player to be the HUNTER for testing
# (leave empty in production / normal play)
DEV_FORCE_HUNTER=

# Optional: log audio that would be played instead of playing mp3s.
# Set to 1 to enable. Useful for verifying segment/audio order without
# listening through recorded narration.
DEBUG_AUDIO=

# Optional: delay (ms) before the day-vote UI opens after dawn (default
# 7000). Set to 0 for rapid automated simulation / headless testing —
# the day:voting-phase-start emit carries no audio, so this only gates
# the UI prompt, not the audio sequence.
DAY_VOTE_DELAY_MS=7000
