{
  "name": "loup-garou",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "lint": "oxlint --deny-warnings",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:mobile": "turbo -F mobile dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:worker": "turbo -F worker dev",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/react": "19.3.0",
    "lint-staged": "^16.1.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "^2.5.4",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.14.0"
}
