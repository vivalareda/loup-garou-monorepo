# Read by `alchemy deploy` / `alchemy dev` from the shell or a git-ignored
# .env next to this file. Never commit the real values.

# Deploy credentials. Locally `alchemy profile edit --add Cloudflare`
# (OAuth or a pasted token, saved in ~/.alchemy) replaces these; CI sets:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional: require ?token=<value> on /room/* and /rooms (unset: open)
# ACCESS_TOKEN=

# `alchemy dev` only: override the game vars from settings.ts
# PLAYER_COUNT=4
# SEGMENT_TIMEOUT_MS=5000
# ENABLE_ADMIN_EVENTS=true
