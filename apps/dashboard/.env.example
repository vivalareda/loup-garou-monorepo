# http(s) base URL of the game server the dashboard (and its mock players)
# connect to; the WebSocket endpoint is ws(s)://<host>/room/<code>.
# Optional: unset, the dashboard uses the origin it is served from (the
# Worker serves it that way, see apps/worker and .env.worker)
VITE_PUBLIC_BACKEND_SERVER_URL=http://localhost:3000
# Optional room code (default "default"); the Node server hosts one game
# and ignores it, the Worker runs one game per code (case-insensitive)
VITE_PUBLIC_ROOM_CODE=
