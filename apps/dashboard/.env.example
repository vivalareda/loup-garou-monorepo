# http(s) base URL of the game server the dashboard (and its mock players)
# connect to; the WebSocket endpoint is ws(s)://<host>/room/<code>.
# Optional: unset, the dashboard uses the origin it is served from (the
# Worker serves it that way, see apps/worker and .env.worker)
VITE_PUBLIC_BACKEND_SERVER_URL=http://localhost:3000
# Optional room the dashboard opens without a ?room=<code> in its URL
# (default "default"). The Node server hosts one game and ignores the
# code; on the Worker a room must be created first (the "+ New room"
# button, the mobile app or POST /rooms)
VITE_PUBLIC_ROOM_CODE=
# The Worker's ACCESS_TOKEN, when it has one (appended as ?token=). It ends
# up in the bundle: a speed bump against scanners, not authentication
VITE_PUBLIC_ACCESS_TOKEN=
